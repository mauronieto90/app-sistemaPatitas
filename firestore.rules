rules_version = '2';

// Reglas de Firestore para Patitas Peludas.
// Requieren el login con Firebase Authentication de index.html. Antes de
// publicarlas, crea los usuarios y sus documentos usuarios/{uid}
// (pasos en SECURITY_AUDIT.md → "Puesta en marcha").
//
// Modelo: cada empleado es un usuario de Firebase Auth y tiene un documento
// usuarios/{uid} con { rol: 'admin' | 'vendedor', activo: true }, creado
// por el administrador desde la consola de Firebase.
//
// Despliegue: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function activo() {
      return signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
             && perfil().activo == true;
    }
    function esAdmin() {
      return activo() && perfil().rol == 'admin';
    }
    function montoValido(campo) {
      return request.resource.data[campo] is number
             && request.resource.data[campo] >= 0
             && request.resource.data[campo] < 100000000;
    }

    // Perfiles: cada quien lee el suyo; solo admin los gestiona.
    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || esAdmin());
      allow write: if esAdmin();
    }

    // Ventas: cualquier empleado activo registra; solo admin corrige o borra.
    match /ventas/{id} {
      allow read: if activo();
      allow create: if activo() && montoValido('valor');
      allow update: if esAdmin() && montoValido('valor');
      allow delete: if esAdmin();
    }

    // Compras y gastos: información financiera, solo administración.
    match /compras/{id} {
      allow read, create, update: if esAdmin();
      allow delete: if esAdmin();
    }
    match /gastos/{id} {
      allow read, create, update: if esAdmin();
      allow delete: if esAdmin();
    }

    // Catálogo: todos lo leen; el vendedor solo puede actualizar el contador de vendidos.
    match /catalogo/{id} {
      allow read: if activo();
      allow create: if esAdmin();
      allow update: if esAdmin()
                    || (activo() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sold']));
      allow delete: if esAdmin();
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
